# ==============================================================================
# DELICIAS DEL VALLE - VARIABLES DE ENTORNO CLIENTE (VITE)
# ==============================================================================
# REGLAS DE SEGURIDAD ESTRICTAS:
# 1. En aplicaciones Single Page Application (SPA) con Vite, todas las variables con
#    prefijo VITE_ se empaquetan en el código JavaScript compilado y son PÚBLICAS.
# 2. NUNCA agregues aquí:
#    - Claves de servicio maestro (SUPABASE_SERVICE_ROLE_KEY)
#    - Contraseñas de base de datos (DATABASE_PASSWORD)
#    - Claves privadas de correo (SMTP, SendGrid, Mailgun)
#    - Tokens de pago o llaves privadas de pasarelas
# 3. La clave VITE_SUPABASE_ANON_KEY es una llave pública ('anon key') que únicamente
#    debe tener permisos restringidos por Row Level Security (RLS) en PostgreSQL.
# ==============================================================================

# URL de tu proyecto de Supabase (ej: https://ahzseugjftsmkdterpgq.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave anónima pública de Supabase (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=tu-anon-public-key
